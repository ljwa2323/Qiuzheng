function criterionCard({ id,title,en,include,exclude }) { return `<article class="editor-card"><div class="editor-title"><div class="criterion-id">${escapeHtml(id)}</div><div><strong>${escapeHtml(title)}</strong><small>${escapeHtml(en)}</small></div><button class="icon-button edit" data-action="edit-criterion" data-id="${escapeHtml(id)}" aria-label=",� ${escapeHtml(id)}">${icon('edit')}</button></div><div class="criteria-columns"><div class="criteria-col"><h4>�����o</h4>${include.map((x,i)=>`<div class="criterion-line">${icon('check')}<span><b>${escapeHtml(id)}${i+1}</b> � ${escapeHtml(x)}</span></div>`).join('')}</div><div class="criteria-col"><h4>�����o</h4>${exclude.map((x,i)=>`<div class="criterion-line exclude">${icon('x')}<span><b>${escapeHtml(id)}${i+include.length+1}</b> � ${escapeHtml(x)}</span></div>`).join('')}</div></div></article>`; }

function searchPage() {
  const query = state.concepts.map(concept => {
    const terms = [...concept.controlled.map(term => `"${term.replace(/\s*\[MeSH\]$/i, '')}"[Mesh]`), ...concept.free.map(term => `"${term}"[tiab]`)];
    return `(${terms.join(' OR ')})`;
  }).join('\nAND\n');
  const termCount = state.concepts.reduce((sum, concept) => sum + concept.controlled.length + concept.free.length, 0);
  return `${header('Search strategy builder','��YY�z����"�#?,'Қ���s�]Z:j0����V41,'Z����� !Y2R��Z쟹�1�F�?, `<button class="ghost-button" data-action="import-search">${icon('upload')} 5N��+�</button><button class="primary-button" data-action="copy-query">${icon('copy')} ��׫�� !</button>`)}
