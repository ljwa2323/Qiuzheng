}

function adjudication() {
  recomputeDerivedCounts();
  const conflicts = screeningConflicts();
  const current = conflicts[state.adjudicationIndex || 0];
  if (!current) {
    return `${header('Adjudication center','P,JAx��^>','`mM�pI�� AI R�Ǔ��w��*�����?)}<div class="empty-state">${icon('users')}<h3>0��A\؀P,J</h3><p>9~�R���"'a9?AI Z�{�;�p��]	��w�|,�jiw�?/p><button class="primary-button" data-nav="screening">X��?/button></div>`;
  }
  const { citation, human, ai } = current;
  const criteriaBlock = state.criteria.slice(0, 4).map((item) => `<div class="criterion-line">${icon('check')}<span><b>${escapeHtml(item.id)}</b> � ${escapeHtml(item.title)}</span></div>`).join('') || '<p class="muted">óߗ#Q?/p>';
  return `${header('Adjudication center','P,JAx��^>','�5��E\��?AI (�a9���h1Ax�P�9�x�?, `<button class="ghost-button" data-action="skip">�)��?/button><button class="primary-button" data-action="next-conflict">�)��D�?${icon('arrow')}</button>`)}<section class="panel"><div class="panel-head"><div><h3>Conflict � Title/abstract</h3><p>${escapeHtml(citation.title)}</p></div><span class="badge red">${conflicts.length} �m)?/span></div><div class="panel-body"><div class="compare-grid">
    ${reviewer((state.user?.name||'H').slice(0,2),'Human',human.decision,human.rationale||'\��R��',human.evidence||citation.abstract?.slice(0,160)||'','green')}
    ${reviewer('AI','Qiuzheng AI',ai.decision,ai.rationale||'�37H��',ai.evidence||'','purple')}
  </div><div class="resolve-box"><div><strong>Ȭ#�P?/strong><div class="muted" style="font-size:9px;margin-top:3px">O�SO�x��GK�Ad\��_��麁��?/div></div><div class="decision-group"><button class="decision-button include ${state.adjudicationResolution==='Include'?'selected':''}" data-resolution="Include" ${state.adjudicationResolution?'disabled':''}>���</button><button class="decision-button exclude ${state.adjudicationResolution==='Exclude'?'selected':''}" data-resolution="Exclude" ${state.adjudicationResolution?'disabled':''}>���</button><button class="decision-button uncertain ${state.adjudicationResolution==='Uncertain'?'selected':''}" data-resolution="Uncertain" ${state.adjudicationResolution?'disabled':''}>�m~</button></div></div></div></section>
  <div class="grid-equal" style="margin-top:16px"><section class="panel"><div class="panel-head"><h3>)?�����o</h3></div><div class="panel-body">${criteriaBlock}</div></section><section class="panel"><div class="panel-head"><h3>�)��y�Y?/h3><span class="badge green">${conflicts.length} remaining</span></div><div class="panel-body"><div class="stats-grid" style="grid-template-columns:repeat(2,1fr);margin:0"><div><b>${state.citations.length}</b><small class="muted" style="display:block">���Zz</small></div><div><b>${conflicts.length}</b><small class="muted" style="display:block">0��P,J</small></div></div></div></section></div>`;
}

function synthesis() {
  recomputeDerivedCounts();
  const screened = state.screeningCompleted;
  const extracted = state.extractionValues.filter((v) => v.value).length;
  const verified = state.extractionValues.filter((v) => v.verified).length;
  const robDone = state.robJudgements.filter((item) => item.actor === 'human').length;
  const readiness = Math.min(100, Math.round(
    (state.citations.length ? 20 : 0)
    + (screened ? 25 : 0)
    + (extracted ? 25 : 0)
    + (robDone ? 15 : 0)
    + (state.audits.length ? 15 : 0),
  ));
  const reports = [
    ['report','PRISMA }�','ip,0��5NƓ��x�?],
    ['search','���"�#�0?,'5N�0��Қ�,'�I'],
    ['table','.�p�?,'�蜻,GA����ɢ�?],
    ['shield','KӬ6��C��?,'�蜸mZ<� RoB R��'],
    ['chart','ۢ�9�?,'\�/AI P��'],
    ['users','\؀P,Jm','0��R� ÷�'],
  ];
  return `${header('Synthesis and reporting','�yAN����[?,'O�N4=�0��$-09~��m�|n{�?)}<div class="report-hero"><div><h2>��O�N4?${readiness}%</h2><p>�� ${state.citations.length} � �,� ${screened} � �,GWޓ�?${extracted} � RoB \�R�� ${robDone}</p></div><button class="primary-button" data-action="generate-draft">${icon('spark')} �-G��}�</button></div><div class="report-grid">${reports.map((r,index)=>`<button class="report-card" data-action="report-card" data-report="${index}"><div class="report-card-icon badge blue">${icon(r[0])}</div><strong>${r[1]}</strong><p>${r[2]}</p><span class="link-button">��M ${icon('arrow',12)}</span></button>`).join('')}</div><div class="grid-equal" style="margin-top:18px"><section class="panel"><div class="panel-head"><div><h3>0��WΔ��</h3><p>�� ScreeningDecision / Extraction / RoB</p></div></div><div class="panel-body"><div class="stats-grid" style="grid-template-columns:repeat(2,1fr);margin:0">${[['�,��',String(screened)],['\؀P,J',String(state.adjudicationRemaining)],['��s`~AY?,String(verified)],['RoB \�$?,String(robDone)]].map(x=>`<div><small class="muted">${x[0]}</small><div style="font-size:22px;font-weight:700;margin-top:5px">${x[1]}</div></div>`).join('')}</div></div></section><section class="panel"><div class="panel-head"><div><h3>�ml�*($?/h3><p>�a9��YF4?/p></div></div><div class="panel-body task-list">${taskRow('layers','amber','E;R��',`S@� ${Math.max(0,state.citations.length-screened)} ��,Math.max(0,state.citations.length-screened),'screening')}${taskRow('shield','red','9~� RoB',`${robDone} $p�9~�`,robDone,'rob')}</div></section></div>`;
}

function reviewer(initial,role,decision,reason,quote,color) { return `<article class="reviewer-card"><div class="reviewer-head"><div class="avatar">${initial}</div><div><strong>${role}</strong><small>Independent decision</small></div></div><div class="reviewer-decision">${escapeHtml(decision||'')}</div><span class="badge ${color}">${decision==='Include'?'���':decision==='Exclude'?'���':'�m~'}</span><p>${escapeHtml(reason||'')}</p><div class="quote">${escapeHtml(quote||'')}</div></article>`; }

function audit() {
  const actors = [...new Set(state.audits.map(event => event.actor))];
  const modulesInLog = [...new Set(state.audits.map(event => event.module).filter(Boolean))];
  const events = state.audits.filter(event => matchesQuery([event.actor,event.action,event.detail,event.version], state.auditQuery))
    .filter(event => state.auditActor === 'O)4���p? || event.actor === state.auditActor)
    .filter(event => state.auditModule === 'O)4�3a' || event.module === state.auditModule);
  return `${header('Audit trail','9~�9�x��','i�\��I ��IR������7c������yh(�yA�?\~�������?, `<button class="primary-button" data-action="export-audit">${icon('download')} 5N���T</button>`)}<section class="panel"><div class="panel-body"><div class="toolbar"><label class="filter-input">${icon('search')}<input data-filter="audit-query" value="${escapeHtml(state.auditQuery)}" placeholder="�Ũ����zd��p" aria-label="�Ũ9�x��" /></label><select class="select" data-filter="audit-actor" aria-label="�7cƬo�?>${['O)4���p?,...actors].map(value=>`<option ${state.auditActor===value?'selected':''}>${escapeHtml(value)}</option>`).join('')}</select><select class="select" data-filter="audit-module" aria-label="�gC�?>${['O)4�3a',...modulesInLog].map(value=>`<option ${state.auditModule===value?'selected':''}>${escapeHtml(value)}</option>`).join('')}</select><span class="muted">${events.length} ɤ�0?/span></div><div class="audit-timeline">${events.length ? events.map(e=>`<article class="audit-event"><header><strong>${escapeHtml(e.actor)} � ${escapeHtml(e.action)}</strong><time>${escapeHtml(e.time)}</time></header><p>${escapeHtml(e.detail)}</p><code>${escapeHtml(e.version)}</code></article>`).join('') : `<div class="empty-state">${icon('search')}<p>A�@�0���2"(�x���0?/p></div>`}</div></div></section>`;
}

