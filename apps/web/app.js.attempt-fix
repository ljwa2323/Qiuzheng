    aiTab: 'decision', aiOpen: true, sidebarOpen: true, screenMode: 'single', screeningIndex: 0,
    decision: null, db: 'PubMed', extractionTab: 'characteristics', extractionView: 'data', modal: null, modalPayload: null, searchQuery: '', libraryQuery: '',
    librarySource: 'O)4��.', libraryFullText: 'O)4O&�5�?, auditQuery: '', auditActor: 'O)4���p?, auditModule: 'O)4�3a',
    projectName: '�D�Z�)?, question: '', criteria: [], concepts: structuredClone(defaultConcepts),
    citations: [], audits: [], screeningDecisions: {}, screeningCompleted: 0, batchDecisions: {}, selectedBatch: [],
    adjudicationIndex: 0, fulltextIndex: 0, projectMembers: [], protocolVersion: null, protocolVersions: [],
    lastAiQuestion: '', lastAiAnswer: '', role: 'viewer', credentialId: '',
    assistantBusy: false, assistantResult: null, adjudicationSuggestion: null,
