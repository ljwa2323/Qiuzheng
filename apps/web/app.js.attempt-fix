  <section class="panel"><div class="panel-head"><div><h3>O)4��</h3><p>${rows.length} �3�S��0?/p></div><span class="badge green">ȅ������</span></div><div class="panel-body"><div class="toolbar"><label class="filter-input">${icon('search')}<input data-filter="library-query" value="${escapeHtml(state.libraryQuery)}" placeholder="�})��w�pk�OI �Ũ" aria-label="�Ũ��" /></label><select class="select" data-filter="library-source" aria-label="�ug.�?>${['O)4��.',...sources].map(value=>`<option ${state.librarySource===value?'selected':''}>${escapeHtml(value)}</option>`).join('')}</select><select class="select" data-filter="library-fulltext" aria-label="�
�����z�?>${['O)4O&�5�?,'�6OY?,'�Q'].map(value=>`<option ${state.libraryFullText===value?'selected':''}>${value}</option>`).join('')}</select><span class="spacer"></span><button class="ghost-button" data-action="export-library">${icon('download')} 5N�</button></div></div><div class="table-wrap"><table><thead><tr><th>��</th><th>�&���.</th><th>�HA4��?/th><th>O&�</th><th>9~�4?/th><th></th></tr></thead><tbody>${rows.length ? rows.map(r=>`<tr><td class="title-cell"><strong>${escapeHtml(r.title)}</strong><small>${escapeHtml(r.authors)}${r.doi?` � DOI ${escapeHtml(r.doi)}`:''}</small></td><td><span class="source-pill">${escapeHtml(r.source)}</span></td><td>${r.hits}</td><td><span class="badge ${r.fullText==='Missing'?'amber':'green'}">${escapeHtml(r.fullText)}</span></td><td class="progress-cell"><div class="progress-track"><span style="width:${Number(r.completeness)||0}%"></span></div></td><td><button class="icon-button" data-action="citation-more" data-id="${escapeHtml(r.id)}" aria-label="�����">${icon('more')}</button></td></tr>`).join('') : `<tr><td colspan="6"><div class="empty-state">${icon('search')}<p>A�@�0��ۢ�o`A���</p></div></td></tr>`}</tbody></table></div></section>`;
}

function screening() {
  if (state.screenMode === 'batch') return batchScreening();
  const c = currentScreenCase();
  const highlighted = c.evidence && c.abstract.includes(c.evidence)
    ? c.abstract.replace(c.evidence, `<mark class="evidence-highlight">${escapeHtml(c.evidence)}</mark>`)
    : escapeHtml(c.abstract);
  const remaining = moduleCount('screening');
  const criteriaRail = state.criteria.length
    ? state.criteria.slice(0, 6).map((item) => `<div class="rail-item"><div class="criterion-id">${escapeHtml(item.id)}</div><span>${escapeHtml(item.title)}</span></div>`).join('')
    : '<p class="muted" style="font-size:11px">��f&ߗ%	��������o</p>';
  return `${header('Title and abstract screening','�<0���Ux��?,')�v�3!,��*&\�R������h*����ӗ�0*�� AI �5n)B�?, `<div class="tabs"><button class="tab active" data-screen-mode="single">W��3!</button><button class="tab" data-screen-mode="batch">�Rz�3!</button></div>`)}
  <div class="screen-layout"><article class="citation-card"><div class="citation-meta"><span>Record ${state.screeningIndex + 1}/${Math.max((state.screeningQueue.length || state.citations.length), 1)}</span><span>${escapeHtml(c.authors)}</span><span>${escapeHtml(c.journal)}</span><span class="badge blue">${state.decision ? (c.ai ? 'AI ��n)? : '`lI�?) : 'Blind mode'}</span></div><div class="citation-main"><h3>${escapeHtml(c.title)}</h3><p>${highlighted}</p></div><div class="decision-bar"><div><div class="decision-group"><button class="decision-button include ${state.decision==='Include'?'selected':''}" data-decision="Include" aria-pressed="${state.decision==='Include'}" ${state.decision||!c.id?'disabled':''}>${icon('check')} ���</button><button class="decision-button exclude ${state.decision==='Exclude'?'selected':''}" data-decision="Exclude" aria-pressed="${state.decision==='Exclude'}" ${state.decision||!c.id?'disabled':''}>${icon('x')} ���</button><button class="decision-button uncertain ${state.decision==='Uncertain'?'selected':''}" data-decision="Uncertain" aria-pressed="${state.decision==='Uncertain'}" ${state.decision||!c.id?'disabled':''}>${icon('alert')} �m~</button></div><div class="keyboard-hints" style="margin-top:8px"><span><kbd>1</kbd> ���</span><span><kbd>2</kbd> ���</span><span><kbd>3</kbd> �m~</span></div></div><div class="case-position">S@� ${remaining} �?/div></div></article>
  <aside class="criteria-rail"><div class="rail-card"><h4>����o</h4>${criteriaRail}</div><div class="rail-card"><h4>0���䔯3!</h4><p class="muted" style="font-size:9px;line-height:1.5">\�R��P� ScreeningDecision�������|3�"'a9�h*���� ModelRun�?/p></div></aside></div>`;
}

function batchScreening() {
  const cases = (state.screeningQueue.length ? state.screeningQueue : state.citations).map((item) => {
    const ai = item.raw?.decisions?.find((d) => d.actor === 'ai');
    const human = item.raw?.decisions?.find((d) => d.actor === 'human');
    return {
      id: item.id,
      title: item.title,
      authors: item.authors,
      ai: ai?.decision || '%?,
      confidence: ai?.confidence || '%?,
      criterion: (ai?.criterionIds || []).join(' � ') || '%?,
      human: human?.decision || '',
    };
  });
  return `${header('Title and abstract screening','�Rzۢ�?,'RD��ȅ����RK1YҲ�A\�I���\�?, `<div class="tabs"><button class="tab" data-screen-mode="single">W��3!</button><button class="tab active" data-screen-mode="batch">�Rz�3!</button></div>`)}<section class="panel"><div class="panel-body"><div class="toolbar"><span class="muted">��� ${state.selectedBatch.length} �?/span><span class="spacer"></span><button class="ghost-button" data-action="batch-confirm" ${state.selectedBatch.length?'':'disabled'}>�Rz��{</button></div></div><div class="table-wrap"><table><thead><tr><th><input type="checkbox" data-batch-all aria-label="O)�?></th><th>��</th><th>AI R��</th><th>���*�</th><th>O�m��o</th><th>\�R��</th></tr></thead><tbody>${cases.length ? cases.map((c,i)=>`<tr><td><input type="checkbox" data-batch-select="${c.id}" aria-label="���" ${state.selectedBatch.includes(String(c.id))?'checked':''}></td><td class="title-cell"><strong>${escapeHtml(c.title)}</strong><small>${escapeHtml(c.authors)}</small></td><td><span class="badge ${c.ai==='Include'?'green':c.ai==='Exclude'?'red':c.ai==='Uncertain'?'amber':'gray'}">${escapeHtml(c.ai)}</span></td><td>${escapeHtml(c.confidence)}</td><td>${escapeHtml(c.criterion)}</td><td><select class="select" data-batch-decision="${c.id}" aria-label="\�R��"><option value="">�m)?/option>${[['Include','���'],['Exclude','���'],['Uncertain','�m~']].map(([value,label])=>`<option value="${value}" ${state.batchDecisions[c.id]===value?'selected':''}>${label}</option>`).join('')}</select></td></tr>`).join('') : `<tr><td colspan="6"><div class="empty-state"><p>ƛ������O�O樲��U�HA�?/p></div></td></tr>`}</tbody></table></div></section>`;
}

function fulltext() {
  const included = includedForFulltext();
  const citation = included[state.fulltextIndex || 0] || included[0];
  if (!citation) {
    return `${header('Full text screening','O&��yA�?�','`mM�*})��Uz�	Q�,�O瑁��?)}<div class="empty-state">${icon('file')}<h3>ƛ�,�O�?/h3><p>��f%�ۗQ���.�}@e�uK,���s5�?/p><button class="primary-button" data-nav="screening">X��?/button></div>`;
  }
  const criteriaRows = state.criteria.length
    ? state.criteria.map((item) => `<button class="eligibility-row" data-action="jump-evidence"><header><span class="status-symbol warn">?</span><strong>${escapeHtml(item.id)} � ${escapeHtml(item.title)}</strong></header><p>${escapeHtml(item.include[0] || '5-�����o�?�X��')}</p></button>`).join('')
    : '<p class="muted">�𛰇�����o</p>';
  return `${header('Full text screening','O&��yA�?�','0��c�dȅ�����Uw��?	��.xDF %pYF=`�Z�;s�φ?, `<button class="ghost-button" data-action="run-fulltext-ai" ${state.credentialId && citation?.id ? '' : 'disabled'}>${icon('spark')} AI �?�</button><button class="ghost-button" data-action="next-fulltext">�)��?/button><button class="primary-button" data-action="fulltext-decision" ${state.fulltextDecision?'':'disabled'}>�*&R��</button>`)}${state.fulltextDecision?`<div class="status-banner">0��R��?strong>${escapeHtml(state.fulltextDecision)}</strong> � O�SO�GTlȬ#�P?/div>`:''}<div class="pdf-layout"><div class="pdf-viewer"><article class="pdf-page"><div style="color:#777;font-size:9px">${escapeHtml(citation.source || 'Citation')} � Abstract</div><h2>${escapeHtml(citation.title)}</h2><p><b>${escapeHtml(citation.authors)}</b></p><h3>Abstract</h3><p class="marked">${escapeHtml(citation.abstract || citation.raw?.abstract || 'ó�U?)}</p></article></div><aside class="eligibility-card"><div class="panel-head"><div><h3>Eligibility</h3><p>${state.criteria.length} $�#Q?/p></div></div>${criteriaRows}<div style="padding:14px"><div class="decision-group"><button class="decision-button include ${state.fulltextDecision==='Include'?'selected':''}" data-action="full-include">���</button><button class="decision-button exclude ${state.fulltextDecision?.startsWith('Exclude')?'selected':''}" data-action="full-exclude">���</button></div></div></aside></div>`;
}

