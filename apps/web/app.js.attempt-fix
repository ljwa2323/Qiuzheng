    <section class="section-stack"><div class="panel"><div class="panel-head"><div><h3>`�	�X�</h3><p>*��U�.Z</p></div></div><div class="panel-body"><p class="muted" style="font-size:12px;line-height:1.6">f%;�&���1�F��� ��d]%����?PRESS mwG�?p$[g���Қ���,'�I|	|H���3C�?/p><div class="criterion-line">${icon('check')} Y*H�GxwFq�?/div><div class="criterion-line">${icon('check')} Y*�?PubMed / Embase ��	?/div><div class="criterion-line">${icon('check')} Y2R5�� !R;�&���1�F</div></div></div></section></div>
    <section class="panel"><div class="panel-head"><div><h3>�HA4��	?/h3><p>`����'ZwD�,'</p></div><div class="tabs">${['PubMed','Embase','Web of Science','CENTRAL'].map(x=>`<button class="tab ${state.db===x?'active':''}" data-db="${x}" aria-pressed="${state.db===x}">${x}</button>`).join('')}</div></div><div class="panel-body"><pre class="code-box">${escapeHtml(state.db==='PubMed'?query:`${state.db} �_v��t���S��G[X"����n\n${query.replaceAll('[tiab]', state.db==='Embase'?':ti,ab':'').replaceAll('[Mesh]','')}`)}</pre></div></section>`;
}

