const emptyCriteria = [];
const defaultConcepts = [
  { id: 'concept-1', index: 'Concept 1', title: 'Systematic review', controlled: ['Systematic Reviews [MeSH]'], free: ['systematic review', 'evidence synthesis', 'meta-analysis', 'rapid review'] },
