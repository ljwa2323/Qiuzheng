        badge: `${res.count || 0} ��,
        summary: `��SO?${res.count || 0} �D��1��C ${(res.skipped || []).length} $x�yA��r�Y�+Jw��,
      };
    } else if (action === 'assistant-extract-cell') {
      const fieldId = state.modalPayload?.fieldId;
      const cid = state.modalPayload?.citationId || citationId;
      if (!cid || !fieldId) throw new Error('�𛵳�*ܻ,GWޓ�?);
      const res = await ExtractionApi.runAi(state.projectId, cid, { credentialId: state.credentialId, fieldIds: [fieldId] });
      await refreshExtractionData();
      state.assistantResult = {
        title: 'Wޓ�xi�?,
        badge: `${res.count || 0}`,
        summary: res.count ? '��t��r�Y�yAP�0��A��? : '�GXP�#	��	�k���.���?,
      };
    } else if (action === 'assistant-adjudication-suggest') {
      if (!citationId) throw new Error('AP,J��');
      const res = await ScreeningApi.adjudicationSuggest(state.projectId, citationId, { credentialId: state.credentialId });
      state.adjudicationSuggestion = res.suggestion;
      state.assistantResult = null;
    } else if (action === 'assistant-report-draft') {
      const prompt = `��d�_�P�5���i4)���}�!�?50K���?${state.citations.length}}��?${state.screeningCompleted}}�?${state.adjudicationRemaining}~AY'��?${state.extractionValues.filter((v) => v.value).length}ooB \� ${state.robJudgements.filter((j) => j.actor === 'human').length}��;
      const res = await LlmApi.chat({
        credentialId: state.credentialId,
        projectId: state.projectId,
        context: { module: 'synthesis' },
        messages: [{ role: 'user', content: prompt }],
      });
      state.assistantResult = { title: '��}�C�', summary: res.content || '', badge: '}�' };
      state.lastAiQuestion = prompt;
      state.lastAiAnswer = res.content || '';
    } else if (action === 'assistant-explain-audit') {
      const ev = state.audits[0];
      const prompt = `���EV�3x�2(`A���v@Ȕ	Z�;�?�?{ev?.actor} � ${ev?.action} � ${ev?.detail}`;
      const res = await LlmApi.chat({
        credentialId: state.credentialId,
        projectId: state.projectId,
        context: { module: 'audit' },
        messages: [{ role: 'user', content: prompt }],
      });
      state.assistantResult = { title: '9�xYIt', summary: res.content || '' };
      state.lastAiQuestion = prompt;
      state.lastAiAnswer = res.content || '';
    } else {
      toast('�FaTB�T$�');
    }
  } catch (err) {
