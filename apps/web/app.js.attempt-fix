}

function extraction() {
  const completed = state.extractionValues.filter((value) => value.value).length;
  const verified = state.extractionValues.filter((value) => value.verified).length;
  return `${header('Structured data extraction','�/V(���AY?,'wD~�
�x0���f%�S�)�1��ܻ,GJxXY�9,+��	����Y5�u�?, `<button class="ghost-button" data-action="run-extract-ai" ${state.credentialId && state.citations[0] ? '' : 'disabled'}>${icon('spark')} AI ��^�,</button><button class="primary-button" data-action="export-csv">${icon('download')} 5N� CSV</button>`)}
  <div class="module-switch"><button class="${state.extractionView==='data'?'active':''}" data-extraction-view="data">${icon('table')} �,G�HA</button><button class="${state.extractionView==='fields'?'active':''}" data-extraction-view="fields">${icon('settings')} A��� <span>${state.extractionFields.length}</span></button></div>
  <div class="stats-grid">${[['$-0A�',state.extractionFields.length],['��^PO�x',completed],['�mI��s`?,verified],['�ns`?,Math.max(0,completed-verified)]].map((x,i)=>`<div class="stat-card"><div class="stat-top">${x[0]}<span class="badge ${i===3?'amber':'green'}">${['�w�V?,'J?,'�yA','Wޓ�?][i]}</span></div><div class="stat-value">${x[1]}</div></div>`).join('')}</div>
  ${state.extractionView === 'fields' ? extractionFieldManager() : extractionDataTable()}`;
}

function robQuestionContext() {
  const domain = state.robDomains.find((item) => item.questions.some((question) => question.key === state.robQuestionKey)) || state.robDomains[0];
  const question = domain?.questions.find((item) => item.key === state.robQuestionKey) || domain?.questions?.[0];
  return { domain, question };
}

function robJudgement(questionKey, actor) {
  return state.robJudgements.find((item) => item.questionKey === questionKey && item.actor === actor);
}

function sourceSentences(text) {
  return (String(text || '').match(/[^.!?��+[.!?��?/g) || []).map((sentence) => sentence.trim()).filter(Boolean);
}

function rob() {
  const citation = state.robCitations.find((item) => item.id === state.robCitationId) || state.robCitations[0];
  const { domain: activeDomain, question: activeQuestion } = robQuestionContext();
  if (!citation || !activeDomain || !activeQuestion) return `${header('Risk of bias','KӬ6��D`?,'�-oR�ǞA�9,r�Y(�+��	���?)}<div class="empty-state">${icon('shield')}<h3>ƛ�Y`�:�?/h3><p>��5N�VmȽ?�'������?/p></div>`;
  const human = robJudgement(activeQuestion.key, 'human');
  const ai = robJudgement(activeQuestion.key, 'ai');
  const activeEvidence = state.robEvidenceDraft || human?.evidenceText || ai?.evidenceText || '';
  const sentences = sourceSentences(citation.abstract);
  const disagreementCount = state.robDomains.flatMap((item) => item.questions).filter((question) => {
    const h = robJudgement(question.key, 'human'); const a = robJudgement(question.key, 'ai'); return h && a && h.judgement !== a.judgement;
  }).length;
  const questionCards = state.robDomains.map((domain) => `<section class="rob-domain-card"><header><span class="criterion-id">${domain.key}</span><div><strong>${escapeHtml(domain.title)}</strong><small>${domain.questions.filter((question)=>robJudgement(question.key,'human')).length}/${domain.questions.length} ��l�*I���?/small></div></header>${domain.questions.map((question) => { const h=robJudgement(question.key,'human'); const a=robJudgement(question.key,'ai'); return `<button class="rob-question ${question.key===activeQuestion.key?'active':''}" data-action="select-rob-question" data-domain="${domain.key}" data-question="${question.key}"><span><b>${question.key}</b>${escapeHtml(question.text)}</span><span class="rob-question-status">${h?`<em class="badge ${h.judgement==='Low risk'?'green':h.judgement==='High risk'?'red':'amber'}">\� ${escapeHtml(h.judgement)}</em>`:'<em class="badge gray">�m��?/em>'}${a?`<em class="badge purple">AI ${escapeHtml(a.judgement)}</em>`:''}</span></button>`; }).join('')}</section>`).join('');
  return `${header('Risk of bias','KӬ6��D`?,'M�����	����-o�?�-!�?signaling question �Z:��\�z�"^�Y~c��X���yA�?, `<button class="ghost-button" data-action="rob-guide">RoB 2 ��!</button><button class="primary-button" data-action="next-study">�)�$-:�?${icon('arrow')}</button>`)}
  <div class="rob-study-toolbar"><label><span>0��.�</span><select class="select" data-rob-citation>${state.robCitations.map((item)=>`<option value="${item.id}" ${item.id===citation.id?'selected':''}>${escapeHtml(item.title)}</option>`).join('')}</select></label><div><span class="badge green">${state.robJudgements.filter((item)=>item.actor==='human').length} $I���?/span><span class="badge ${disagreementCount?'red':'gray'}">${disagreementCount} $I�Ď�?/span></div></div>
  <div class="rob-review-layout"><section class="rob-source-panel"><div class="panel-head"><div><h3>X���yA</h3><p>${escapeHtml(citation.authors || '')}${citation.year?` � ${escapeHtml(citation.year)}`:''}</p></div><span class="badge blue">Abstract</span></div><article class="rob-source-document"><h2>${escapeHtml(citation.title)}</h2><p class="source-help">p�`��Y�+��O�`~R�S��J,��\���~�yA|6�\�	�R�?/p><div class="source-sentences">${sentences.length ? sentences.map((sentence)=>`<button class="source-sentence ${sentence===activeEvidence?'selected':''}" data-action="rob-use-evidence" data-evidence="${escapeHtml(sentence)}">${sentence===activeEvidence?'<mark>':''}${escapeHtml(sentence)}${sentence===activeEvidence?'</mark>':''}</button>`).join('') : '<div class="empty-state"><p>��0���
r"&�Uu����O&�Z�@cý�\�?/p></div>'}</div></article></section>
  <aside class="rob-assessment-panel"><div class="rob-question-list">${questionCards}</div><section class="rob-editor"><div class="rob-editor-head"><div><span class="criterion-id">${activeQuestion.key}</span><h3>${escapeHtml(activeQuestion.text)}</h3></div></div><div class="rob-evidence-box ${activeEvidence?'has-evidence':''}"><strong>${activeEvidence?'�,�9,+�?:'O-m~X��'}</strong><p>${escapeHtml(activeEvidence || '��j�?vp�s�D��0��R��(�+��^)�?)}</p><small>${escapeHtml(human?.sourceLocation || ai?.sourceLocation || 'Abstract')}</small></div><div class="form-grid rob-form"><div class="field"><label for="rob-answer">�3��}e��</label><select id="rob-answer" name="rob-answer">${['Yes','Probably yes','Probably no','No','No information'].map((value)=>`<option ${value===(human?.answer||'No information')?'selected':''}>${value}</option>`).join('')}</select></div><div class="field"><label for="rob-judgement">��YR��</label><select id="rob-judgement" name="rob-judgement">${['Low risk','Some concerns','High risk'].map((value)=>`<option ${value===(human?.judgement||'Some concerns')?'selected':''}>${value}</option>`).join('')}</select></div><div class="field full"><label for="rob-rationale">R���q</label><textarea id="rob-rationale" name="rob-rationale" placeholder="�X�X��ᙍ��R��">${escapeHtml(human?.rationale || '')}</textarea></div></div>${ai?`<div class="ai-rob-suggestion"><div><span class="badge purple">AI Hm�</span><strong>${escapeHtml(ai.answer)} � ${escapeHtml(ai.judgement)}</strong></div><p>${escapeHtml(ai.rationale || '')}</p><button class="link-button" data-action="show-ai-rob-evidence">��E AI ��dX��</button></div>`:''}<div class="rob-editor-actions"><button class="ghost-button" data-action="run-rob-ai" ${state.robBusy?'disabled':''}>${icon('spark')} ${state.robBusy?'AI R�=�[�?:'AI Hm�R��'}</button><button class="primary-button" data-action="save-rob" ${activeEvidence?'':'disabled'}>${icon('check')} ���\�R��</button></div>${!state.credentialId?'<p class="rob-credent