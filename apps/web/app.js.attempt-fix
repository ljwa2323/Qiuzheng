function handleAction(action, event) {
  if (action === 'menu') { state.sidebarOpen = !state.sidebarOpen; app(); return; }
  if (action === 'ai-toggle') { state.aiOpen = !state.aiOpen; app(); return; }
  if (action === 'ai-close') { state.aiOpen = false; app(); return; }
  if (action === 'global-search') { state.searchQuery = ''; state.modal = 'search'; app(); return; }
  if (action === 'settings' || action === 'project') { state.modal = 'settings'; state.modalPayload = null; app(); return; }
  if (action === 'schema') { state.extractionView = 'fields'; persistState(); app(); return; }
  if (action === 'add-extraction-field') { state.modal = 'extraction-field'; state.modalPayload = {}; app(); return; }
  if (action === 'edit-extraction-field') { state.modal = 'extraction-field'; state.modalPayload = { fieldId: event.currentTarget.dataset.id }; app(); return; }
  if (action === 'archive-extraction-field') { state.modal = 'archive-extraction-field'; state.modalPayload = { fieldId: event.currentTarget.dataset.id }; app(); return; }
  if (action === 'edit-extraction-value') { state.modal = 'extraction-value'; state.modalPayload = { citationId: event.currentTarget.dataset.citationId, fieldId: event.currentTarget.dataset.fieldId }; app(); return; }
  if (action === 'import' || action === 'import-search') { state.modal = 'import'; state.modalPayload = {}; app(); return; }
  if (action === 'edit-criterion') { state.modal = 'criterion'; state.modalPayload = { id: event.currentTarget.dataset.id }; app(); return; }
  if (action === 'add-criterion') { state.modal = 'criterion'; state.modalPayload = {}; app(); return; }
  if (action === 'edit-question') { state.modal = 'question'; state.modalPayload = {}; app(); return; }
  if (action === 'add-concept') { state.modal = 'concept'; state.modalPayload = {}; app(); return; }
  if (action === 'add-term') { state.modal = 'term'; state.modalPayload = { id: event.currentTarget.dataset.id }; app(); return; }
  if (action === 'modal-backdrop' && event.target !== event.currentTarget) return;
  if (action === 'modal-close' || action === 'modal-backdrop') { state.modal = null; state.modalPayload = null; app(); return; }
  if (action === 'modal-save') { saveModal(); return; }
  if (action === 'copy-query') { const text=document.querySelector('.code-box')?.textContent||''; navigator.clipboard?.writeText(text).then(()=>toast('0���HA4��� !��2R?)).catch(()=>toast('óv�W�SG�!��T%2R?)); return; }
  if (action === 'remove-term') { const concept=state.concepts.find(item=>item.id===event.currentTarget.dataset.id); concept?.free.splice(Number(event.currentTarget.dataset.index),1); auditEvent('�ZΫ��#','���"�#�ˮ��Xʆ?,'Search','Search draft'); app(); toast('��,)�?); return; }
  if (action === 'send') {
    const ta = event.currentTarget.closest('.compose-box').querySelector('textarea');
    if (!ta.value.trim()) return;
    state.lastAiQuestion = ta.value.trim();
    if (!state.credentialId) {
      state.lastAiAnswer = '��f))���Q����37Q_An�?NVIDIA / OpenAI / DeepSeek / wD~��?;
      app();
      return;
    }
    const citationId = assistantFocusId(state, { currentScreenCase, includedForFulltext, screeningConflicts });
    state.assistantBusy = true;
    app();
    LlmApi.chat({
      credentialId: state.credentialId,
      projectId: state.projectId,
      context: { module: state.active, citationId: citationId || undefined },
      messages: [{ role: 'user', content: state.lastAiQuestion }],
    }).then((res) => {
      state.lastAiAnswer = res.content || '';
      state.assistantBusy = false;
      app();
      toast('�Ҁ\�bT2�+�"��e��');
    }).catch((err) => {
      state.assistantBusy = false;
      app();
      toast(err.message || '�37��d���');
    });
    return;
  }
  if (action.startsWith('assistant-') || action === 'run-fulltext-ai' || action === 'run-extract-ai') {
    runAssistantAction(action === 'run-fulltext-ai' ? 'assistant-fulltext-ai' : action === 'run-extract-ai' ? 'assistant-extract-row' : action);
    return;
  }
  if (action === 'next-conflict' || action === 'skip') {
    const conflicts = screeningConflicts();
    state.adjudicationResolution = null;
    state.adjudicationIndex = conflicts.length ? ((state.adjudicationIndex || 0) + 1) % conflicts.length : 0;
    app();
    return;
  }
  if (action === 'next-fulltext') {
    const included = includedForFulltext();
    state.fulltextDecision = null;
    state.fulltextIndex = included.length ? ((state.fulltextIndex || 0) + 1) % included.length : 0;
    app();
    return;
  }
  if (action === 'generate-draft') {
    recomputeDerivedCounts();
    const markdown = `# ${state.projectName}\n\n> Generated ${new Date().toISOString()}\n\n## Live project status\n\n- Citations: ${state.citations.length}\n- Screened: ${state.screeningCompleted}\n- Conflicts: ${state.adjudicationRemaining}\n- Extraction cells filled: ${state.extractionValues.filter((v)=>v.value).length}\n- RoB human judgements: ${state.robJudgements.filter((j)=>j.actor==='human').length}\n- Audit events: ${state.audits.length}\n`;
    downloadFile('qiuzheng-report-draft.md', markdown, 'text/markdown;charset=utf-8');
    auditEvent('Generated report draft', 'Draft built from live server-backed counts.', 'Synthesis', 'Report draft');
    toast('��}ȸm^?);
    return;
  }
  if (action === 'validate-search' || action === 'fix-search' || action === 'recheck' || action === 'workflow-detail' || action === 'replace-pdf') {
    toast('��7c���*���HA�3!3�)X4,뫬�!�G��x�O�������37�?);
    return;
  }
  if (action === 'seed-demo') {
    ProjectApi.seedDemo(state.projectId).then(async () => {
      await refreshProjectData();
      app();
      toast('U�HA��SO�GTlr*��ۢ�?�,G?);
    }).catch((err) => toast(err.message));
    return;
  }
  if (action === 'logout') { handleLogout(); return; }
  if (action === 'switch-project') { state.boot = 'picker'; app(); return; }
  if (action === 'batch-confirm') {
    const unresolved = state.selectedBatch.filter((id) => !state.batchDecisions[id]);
    if (unresolved.length) { toast(`i;A ${unresolved.length} �m��\�R��`); return; }
    Promise.all(state.selectedBatch.map((id) => ScreeningApi.submitHuman(state.projectId, id, {
      decision: state.batchDecisions[id],
      criterionIds: [],
    }))).then(async () => {
      state.selectedBatch = [];
      await refreshProjectData();
      app();
      toast('�Rz\�R�Ǹ�SO�GTl');
    }).catch((err) => toast(err.message || '�Rz��趫�'));
    return;
  }
  if (action === 'full-include') { state.fulltextDecision='Include'; persistState(); app(); return; }
  if (action === 'full-exclude') { state.modal='exclusion'; state.modalPayload={}; app(); return; }
  if (action === 'fulltext-decision') {
    if (!state.fulltextDecision) return;
    const included = includedForFulltext();
    const citation = included[state.fulltextIndex || 0] || included[0];
    if (!citation?.id) { toast('AYA\��O&���'); return; }
    const decision = state.fulltextDecision.startsWith('Exclude') ? 'Exclude' : state.fulltextDecision;
    ScreeningApi.submitFinal(state.projectId, citation.id, {
      decision,
      criterionIds: [],
      rationale: 'Full-text eligibility check against current protocol criteria',
      evidence: citation.abstract || '',
    }).then(async () => {
      state.fulltextDecision = null;
      await refreshProjectData();
      const next = includedForFulltext();
      state.fulltextIndex = next.length ? ((state.fulltextIndex || 0) % next.length) : 0;
      app();
      toast('O&�R�Ǹ�SO�GTl');
    }).catch((err) => toast(err.message || 'O&�R����趫�'));
    return;
  }
  if (action === 'jump-evidence') { document.getElementById('evidence-methods')?.scrollIntoView({behavior:'smooth',block:'center'}); toast('�6�^␀�B9�5p2X���yA'); return; }
  if (action === 'select-rob-question') {
    state.robQuestionKey = event.currentTarget.dataset.question;
    const human = robJudgement(state.robQuestionKey, 'human');
    const ai = robJudgement(state.robQuestionKey, 'ai');
    state.robEvidenceDraft = human?.evidenceText || ai?.evidenceText || '';
    app();
    return;
  }
  if (action === 'rob-use-evidence') { state.robEvidenceDraft = event.currentTarget.dataset.evidence || ''; app(); toast('�Ң��^~�ċS���`�X���yA'); return; }
  if (action === 'show-ai-rob-evidence') { const ai=robJudgement(state.robQuestionKey,'ai'); state.robEvidenceDraft=ai?.evidenceText||''; app(); return; }
  if (action === 'save-rob') { saveRobJudgement(); return; }
  if (action === 'run-rob-ai') { runRobAi(); return; }
  if (action === 'next-study') {
    const currentIndex = Math.max(0, state.robCitations.findIndex((item) => item.id === state.robCitationId));
    const next = state.robCitations[(currentIndex + 1) % Math.max(state.robCitations.length, 1)];
    if (next) refreshRobData(next.id).catch((err)=>toast(err.message || 'T�G���'));
    return;
  }
  if (action === 'dedupe') { const seen=new Set(); const before=state.citations.length; state.citations=state.citations.filter(item=>{const key=(item.doi||item.title).toLowerCase(); if(seen.has(key)) return false; seen.add(key); return true;}); auditEvent('i/��XZx',`���?${before} ɤ�0�Z� ${before-state.citations.length} ��x����,'Library','Dedupe v1'); app(); toast(`XZx9~�,��?${before-state.citations.length} ��); return; }
  if (action === 'export-library') { downloadFile('qiuzheng-citations.csv',toCsv(state.citations,[{key:'title',label:'Title'},{key:'authors',label:'Authors'},{key:'source',label:'Source'},{key:'doi',label:'DOI'},{key:'fullText',label:'Full text'}]),'text/csv;charset=utf-8'); toast('��4?CSV ���Q?); return; }
  if (action === 'export-audit') { downloadFile('qiuzheng-audit.csv',toCsv(state.audits,[{key:'time',label:'Time'},{key:'actor',label:'Actor'},{key:'module',label:'Module'},{key:'action',label:'Action'},{key:'detail',label:'Detail'},{key:'version',label:'Version'}]),'text/csv;charset=utf-8'); toast('9�x��T���Q?); return; }
  if (action === 'export-csv') { const rows=state.citations.map((citation)=>Object.fromEntries([['study',citation.title],...state.extractionFields.map((field)=>[field.key,extractionValue(citation.id,field.id)?.value||''])])); const columns=[{key:'study',label:'Study'},...state.extractionFields.map((field)=>({key:field.key,label:field.label}))]; downloadFile('qiuzheng-extraction.csv',toCsv(rows,columns),'text/csv;charset=utf-8'); toast('���0��A���5N��HA�,G CSV'); return; }
  if (action === 'export') { recomputeDerivedCounts(); downloadFile('qiuzheng-project-status.json',JSON.stringify({project:state.projectName,exportedAt:new Date().toISOString(),screeningRemaining:moduleCount('screening'),adjudicationRemaining:state.adjudicationRemaining,citations:state.citations.length},null,2),'application/json'); toast('$-05�x�5N�'); return; }
  if (action === 'report-card') { const reports=[['PRISMA }�','ip,0��5NƓ��x�?],['���"�#�0?,'5N�0��Қ�,'�I'],['.�p�?,'�蜻,GA����ɢ�?],['KӬ6��C��?,'�蜸mZ<� RoB R��'],['ۢ�9�?,'\�/AI P��'],['\؀P,Jm','0��R� ÷�']]; const report=reports[Number(event.currentTarget.dataset.report)]||reports[0]; state.modal='report'; state.modalPayload={title:report[0],description:report[1]}; app(); return; }
  if (action === 'citation-more') { state.modal='citation'; state.modalPayload=state.citations.find(item=>item.id===event.currentTarget.dataset.id)||{}; app(); return; }
  if (action === 'notification') { state.notificationsRead=true; persistState(); state.modal='notifications'; app(); return; }
  if (action === 'team') { state.modal='team'; app(); return; }
  if (action === 'history') { state.modal='history'; app(); return; }
  const messages = {
    'rob-guide':'0����c�d RoB 2 �����4�1��oR��Gt~X���yA�?,
    'concept-more':'Қ����mZ:j��V?,
