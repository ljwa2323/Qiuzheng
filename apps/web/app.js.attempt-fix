function extractionFieldManager() {
  return `<section class="panel field-manager"><div class="panel-head"><div><h3>A���</h3><p>A����f))����1�hRʴ-x�n�0ޗ`�0�Ȁ�?/p></div><button class="primary-button" data-action="add-extraction-field">${icon('plus')} �A�</button></div><div class="field-manager-list">${state.extractionFields.map((field) => `<article class="field-manager-row"><div class="field-type-icon">${icon(field.dataType === 'number' ? 'chart' : field.dataType === 'boolean' ? 'check' : 'table')}</div><div class="field-manager-main"><div><strong>${escapeHtml(field.label)}</strong>${field.required ? '<span class="badge red">Gm^</span>' : ''}<span class="badge gray">${escapeHtml(extractionGroupLabels[field.group] || field.group)}</span></div><code>${escapeHtml(field.key)}</code><p>${escapeHtml(field.description || 'ƛ�A��X�')}</p></div><div class="field-manager-meta"><span>${escapeHtml(extractionTypeLabels[field.dataType] || field.dataType)}</span><small>R�p�0${escapeHtml(field.creator?.name || '�d�')}</small></div><div class="field-manager-actions"><button class="icon-button" data-action="edit-extraction-field" data-id="${field.id}" aria-label=",� ${escapeHtml(field.label)}">${icon('edit')}</button><button class="icon-button danger" data-action="archive-extraction-field" data-id="${field.id}" aria-label="0� ${escapeHtml(field.label)}">${icon('x')}</button></div></article>`).join('') || `<div class="empty-state">${icon('table')}<h3>i;��AY'�?/h3><p>R�����D�[�W�r��,����,G�?/p></div>`}</div></section>`;
}

function extractionDataTable() {
