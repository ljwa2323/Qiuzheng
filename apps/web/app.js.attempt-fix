  const studies = state.citations.slice(0, 50);
  return `<section class="panel"><div class="panel-head"><div><h3>${extractionGroupLabels[state.extractionTab]}</h3><p>p�Wޓ�N^P�:�x+��	�����.c��</p></div><div class="tabs">${Object.entries(extractionGroupLabels).map(([id,label])=>`<button class="tab ${state.extractionTab===id?'active':''}" data-extraction-tab="${id}">${label}</button>`).join('')}</div></div>${fields.length ? `<div class="table-wrap"><table class="sheet"><thead><tr><th class="study-col">Study</th>${fields.map((field)=>`<th>${escapeHtml(field.label)}${field.required?' *':''}</th>`).join('')}</tr></thead><tbody>${studies.map((citation)=>`<tr><td class="study-col"><strong>${escapeHtml(citation.title)}</strong><small>${escapeHtml(citation.authors)}</small></td>${fields.map((field)=>{const saved=extractionValue(citation.id,field.id);return `<td><button class="data-cell extraction-cell ${saved?.verified?'is-verified':''}" data-action="edit-extraction-value" data-citation-id="${citation.id}" data-field-id="${field.id}"><span>${escapeHtml(saved?.value || '�nAY?)}</span>${saved?.evidenceText?'<small>�
+��	�?/small>':''}${saved?.verified?'<span class="verified">A?��s`?/span>':''}</button></td>`;}).join('')}</tr>`).join('') || `<tr><td colspan="${fields.length+1}"><div class="empty-state"><p>O-�YAY+:�?/p></div></td></tr>`}</tbody></table></div><div class="sheet-footer"><span>${studies.length} studies � ${fields.length} �D�?/span><span>ȅ���T$Z?/span></div>` : `<div class="empty-state">${icon('table')}<h3>i�Rٍi;��
