# Application
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
# Optional reverse-proxy API prefix (e.g. /qiuzheng-api). Affects refresh-cookie path.
# PUBLIC_API_PREFIX=

# Database
DATABASE_URL=postgresql://qiuzheng:qiuzheng@localhost:5432/qiuzheng?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets (generate strong random values in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AES-256-GCM key for encrypting user API credentials (32 bytes hex = 64 chars)
CREDENTIALS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=qiuzheng
S3_SECRET_KEY=qiuzheng_secret
S3_BUCKET=qiuzheng
S3_FORCE_PATH_STYLE=true
STORAGE_DRIVER=s3
LOCAL_STORAGE_PATH=../../.runtime/objects

# Upload limits
MAX_UPLOAD_BYTES=52428800

# Optional: Python for PyMuPDF4LLM PDF->Markdown (falls back to unpdf if missing)
# QIUZHENG_PYTHON=python

# Optional web build / preview overrides (prefer apps/web/.env.local)
# VITE_BASE_PATH=/
# VITE_API_PREFIX=
# VITE_API_PROXY_TARGET=http://localhost:3000
# VITE_PREVIEW_PORT=8080
# VITE_ALLOWED_HOSTS=localhost
